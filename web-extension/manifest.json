{
  "manifest_version": 3,
  "name": "Prospector Autofill",
  "version": "0.5.4",
  "description": "Fills job application forms with your prepared answers from Prospector, and sends any job page into the pipeline. Nothing is submitted automatically.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "action": {
    "default_title": "Send this job to Prospector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-engine-c8f9c.web.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "bridge.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fill.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
