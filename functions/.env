WORKER_URL=https://job-engine-worker-474365472589.us-central1.run.app
WORKER_INVOKER_SA=task-invoker@job-engine-c8f9c.iam.gserviceaccount.com
TASKS_QUEUE=submissions
TASKS_LOCATION=us-central1
# Bucket the resume-upload trigger watches — must match the bucket the web
# app uploads to (NEXT_PUBLIC_FB_STORAGE_BUCKET in web/.env.local), and the
# trigger must be deployed in the bucket's region (Eventarc requirement).
STORAGE_BUCKET=job-engine-c8f9c.firebasestorage.app
STORAGE_REGION=us-east1

# --- Models -----------------------------------------------------------
# Default (everything not listed below) is claude-sonnet-5, set in
# shared/llm.py. The roles here run on Haiku 4.5 at half that price:
# high volume, low judgement, and nothing they get wrong is irreversible.
#
# Deliberately NOT here, and why: drafting and critique are the product;
# screening_answers and resume_tailor go to employers under Eric's name;
# resume feeds every match that follows it; agent fills and submits real
# applications. Those stay on the better model.
#
# Rollback is per line: delete one, redeploy. LLM_MODEL_MATCHING is the
# first to pull if scores drift.
LLM_MODEL_MATCHING=claude-haiku-4-5
LLM_MODEL_EXTRACT=claude-haiku-4-5
LLM_MODEL_DISCOVERY=claude-haiku-4-5
LLM_MODEL_JUDGE=claude-haiku-4-5
LLM_MODEL_SYNONYMS=claude-haiku-4-5
LLM_MODEL_METRO=claude-haiku-4-5
LLM_MODEL_TRACK=claude-haiku-4-5